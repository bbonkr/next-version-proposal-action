{
  "name": "next-version-proposal-action",
  "version": "1.1.0",
  "private": true,
  "description": "Github action which recommends a name for the next version based on your git tag and pull request labels",
  "main": "lib/main.js",
  "scripts": {
    "build": "tsc",
    "format": "prettier --write '**/*.ts'",
    "format-check": "prettier --check '**/*.ts'",
    "lint": "eslint src/**/*.ts",
    "package": "ncc build --source-map --license licenses.txt",
    "test": "jest",
    "test:clear": "jest --clearCache",
    "all": "npm run format && npm run lint && npm run build && npm run package"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bbonkr/next-version-proposal-action.git"
  },
  "keywords": [
    "actions",
    "github",
    "git",
    "git tag",
    "version-working"
  ],
  "author": {
    "email": "dev@bbon.kr",
    "name": "Pon Cheol Ku (구본철)",
    "url": "https://bbon.kr"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@octokit/graphql": "^9.0.5"
  },
  "devDependencies": {
    "@octokit/plugin-rest-endpoint-methods": "^18.0.0",
    "@octokit/types": "^18.0.0",
    "@types/node": "^24.19.2",
    "@typescript-eslint/parser": "^8.72.1",
    "@vercel/ncc": "^0.45.0",
    "dotenv": "^18.0.9",
    "eslint": "^10.14.0",
    "eslint-plugin-github": "^6.1.2",
    "eslint-plugin-jest": "^29.17.0",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "js-yaml": "^5.5.0",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3"
  }
}
